# Build a private OpenJPEG integration from pinned upstream sources and a
# reviewable patch. No substring/regex rewriting of C sources at configure time.
function(ebcc_configure_openjpeg)
  find_package(Git REQUIRED)
  set(_source "${CMAKE_CURRENT_SOURCE_DIR}/openjpeg/src/lib/openjp2")
  set(_support "${CMAKE_CURRENT_SOURCE_DIR}/openjpeg_support")
  set(_copy "${CMAKE_CURRENT_BINARY_DIR}/openjp2_ebcc")
  set(_stage "${CMAKE_CURRENT_BINARY_DIR}/openjp2_ebcc_stage")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${_support}/upstream.sha256" "${_support}/ebcc.patch")

  # Content checks work for Git checkouts and source archives alike. Normalize
  # CRLF before hashing/applying so Windows checkouts have the same identity.
  file(STRINGS "${_support}/upstream.sha256" _manifest)
  file(GLOB _sources CONFIGURE_DEPENDS RELATIVE "${_source}" "${_source}/*.c" "${_source}/*.h")
  set(_expected)
  file(REMOVE_RECURSE "${_stage}")
  file(MAKE_DIRECTORY "${_stage}")
  foreach(_entry IN LISTS _manifest)
    string(SUBSTRING "${_entry}" 0 64 _hash)
    string(SUBSTRING "${_entry}" 66 -1 _name)
    list(APPEND _expected "${_name}")
    if(NOT EXISTS "${_source}/${_name}")
      message(FATAL_ERROR "EBCC OpenJPEG integration: missing upstream ${_name}. See openjpeg_support/README.md.")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_source}/${_name}")
    file(READ "${_source}/${_name}" _content)
    string(REPLACE "\r\n" "\n" _content "${_content}")
    string(SHA256 _actual "${_content}")
    if(NOT _actual STREQUAL _hash)
      message(FATAL_ERROR "EBCC OpenJPEG integration: unsupported upstream ${_name} (SHA256 ${_actual}). Review the patch and update its source manifest; see openjpeg_support/README.md.")
    endif()
    file(WRITE "${_stage}/${_name}" "${_content}")
  endforeach()
  list(SORT _expected)
  list(SORT _sources)
  if(NOT _sources STREQUAL _expected)
    message(FATAL_ERROR "EBCC OpenJPEG source inventory changed. See openjpeg_support/README.md.")
  endif()

  # --no-index works without a repository, including unpacked release sources.
  # Apply only to staging; failed application cannot leave half-patched builds.
  execute_process(COMMAND "${GIT_EXECUTABLE}" apply --no-index --check "${_support}/ebcc.patch"
    WORKING_DIRECTORY "${_stage}" RESULT_VARIABLE _result ERROR_VARIABLE _error)
  if(NOT _result EQUAL 0)
    message(FATAL_ERROR "EBCC OpenJPEG patch check failed: ${_error}")
  endif()
  execute_process(COMMAND "${GIT_EXECUTABLE}" apply --no-index "${_support}/ebcc.patch"
    WORKING_DIRECTORY "${_stage}" RESULT_VARIABLE _result ERROR_VARIABLE _error)
  if(NOT _result EQUAL 0)
    message(FATAL_ERROR "EBCC OpenJPEG patch application failed: ${_error}")
  endif()
  foreach(_name IN LISTS _expected)
    configure_file("${_stage}/${_name}" "${_copy}/${_name}" COPYONLY)
  endforeach()
  foreach(_name ebcc_mct_float.h ebcc_t1_quantize.h ebcc_quantize.h)
    configure_file("${CMAKE_CURRENT_SOURCE_DIR}/${_name}" "${_copy}/${_name}" COPYONLY)
  endforeach()
  file(REMOVE_RECURSE "${_stage}")

  get_target_property(_target_sources ${OPENJPEG_LINK_TARGET} SOURCES)
  set(_private_sources)
  foreach(_file IN LISTS _target_sources)
    get_filename_component(_directory "${_file}" DIRECTORY)
    if(_directory STREQUAL _source)
      get_filename_component(_name "${_file}" NAME)
      list(APPEND _private_sources "${_copy}/${_name}")
    else()
      list(APPEND _private_sources "${_file}")
    endif()
  endforeach()
  set_property(TARGET ${OPENJPEG_LINK_TARGET} PROPERTY SOURCES "${_private_sources}")
  # Private structs must never interact with a host application's OpenJPEG.
  target_compile_definitions(${OPENJPEG_LINK_TARGET} PUBLIC OPJ_STATIC)
  set_target_properties(${OPENJPEG_LINK_TARGET} PROPERTIES C_VISIBILITY_PRESET hidden)
  set(EBCC_OPENJPEG_INCLUDE_DIR "${_copy}" PARENT_SCOPE)
endfunction()

ebcc_configure_openjpeg()
